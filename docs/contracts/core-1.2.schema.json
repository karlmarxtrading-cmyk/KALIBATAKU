    "BatchReceipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "receipt_origin": {
          "type": "string",
          "enum": [
            "mock",
            "server"
          ]
        },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "payload_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "transport_result": {
                "type": "string",
                "enum": [
                  "accepted",
                  "duplicate",
                  "rejected",
                  "retry_required",
                  "conflict"
                ]
              },
              "grading_state": {
                "type": "string",
                "enum": [
                  "unverified",
                  "queued",
                  "verified",
                  "rejected"
                ]
              },
              "error_code": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "event_id",
              "payload_hash",
              "transport_result",
              "grading_state",
              "error_code"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "missing_sequences": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "receipt_origin",
        "batch_id",
        "received_at",
        "attempt_id",
        "receipts",
        "missing_sequences"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "receipt_origin": {
                "const": "mock"
              }
            }
          },
          "then": {
            "properties": {
              "receipts": {
                "items": {
                  "properties": {
                    "grading_state": {
                      "const": "unverified"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },

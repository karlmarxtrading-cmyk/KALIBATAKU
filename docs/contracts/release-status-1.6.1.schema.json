      "pattern": "^kalibataku-static-\\d+\\.\\d+\\.\\d+$"
    },
    "app_version": {
      "type": "string"
    },
    "bank_version": {
      "type": "string"
    },
    "dist_tree_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "offline_release": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "qa_binding": {
      "type": "string"
    },

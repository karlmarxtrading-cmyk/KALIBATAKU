        "type": "object",
        "required": [
          "status",
          "label",
          "criteria",
          "evidence",
          "claim_boundary",
          "blockers"
        ],
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "HOLD",
              "FAIL",
              "NOT_PERFORMED",
              "NOT_RUN",
              "DEFERRED_BY_SCOPE",
              "PREVIEW_PASS",
              "TECHNICAL_PASS_USABILITY_NOT_VALIDATED"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claim_boundary": {
            "type": "string",
            "minLength": 10
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "enum": [
              "GO",
              "READY_FOR_VALIDATION",
              "HOLD"
            ]
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^AC:"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "schema": {
      "const": "release-status-1.6.1"
    },
    "qa_binding_verified": {
      "type": "boolean"
    },
    "release_label": {
      "enum": [
